<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Type scale -->
    <style name="TextAppearance.Fairberry.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.Fairberry.SectionTitle" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/accent</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
    <style name="TextAppearance.Fairberry.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.Fairberry.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <!-- Cell type carries no colour: the colour a cell shows depends on whether it is a
         filled button, an outlined button or a plain key cell, so each widget style sets it. -->
    <style name="TextAppearance.Fairberry.Cell" parent="TextAppearance.Material3.LabelLarge">
    </style>
    <style name="TextAppearance.Fairberry.TableCell" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.Fairberry.TableHeader" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.06</item>
    </style>
    <style name="TextAppearance.Fairberry.Status" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/state_idle</item>
    </style>
    <style name="TextAppearance.Fairberry.Mono" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <!-- Shapes -->
    <style name="ShapeAppearance.Fairberry.Card" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_card</item>
    </style>
    <style name="ShapeAppearance.Fairberry.Cell" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_cell</item>
    </style>

    <!-- Cards -->
    <style name="Widget.Fairberry.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Fairberry.Card</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.Fairberry.SectionTitle" parent="">
        <item name="android:textAppearance">@style/TextAppearance.Fairberry.SectionTitle</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.Fairberry.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Fairberry.Cell</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/row_height</item>
        <item name="android:textAppearance">@style/TextAppearance.Fairberry.Cell</item>
    </style>
    <style name="Widget.Fairberry.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Fairberry.Cell</item>
        <item name="strokeColor">@color/accent_stroke</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/row_height</item>
        <item name="android:textAppearance">@style/TextAppearance.Fairberry.Cell</item>
    </style>
    <style name="Widget.Fairberry.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Fairberry.Cell</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/row_height</item>
        <item name="android:textAppearance">@style/TextAppearance.Fairberry.Cell</item>
    </style>
    <style name="Widget.Fairberry.Segment" parent="Widget.Material3.Button.TextButton">
        <item name="android:checkable">true</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="backgroundTint">@color/segment_bg</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Fairberry.Cell</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/row_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Fairberry.Cell</item>
    </style>

    <!-- Table and grid cells -->
    <style name="Widget.Fairberry.KeyCell" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/text_primary</item>
        <item name="backgroundTint">@color/cell_bg</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/accent_container</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Fairberry.Cell</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/row_height</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:insetTop">1dp</item>
        <item name="android:insetBottom">1dp</item>
        <item name="android:paddingLeft">@dimen/space_xs</item>
        <item name="android:paddingRight">@dimen/space_xs</item>
        <item name="android:paddingTop">@dimen/space_sm</item>
        <item name="android:paddingBottom">@dimen/space_sm</item>
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">@style/TextAppearance.Fairberry.Cell</item>
    </style>
    <style name="Widget.Fairberry.TableCell" parent="Widget.Fairberry.KeyCell">
        <item name="android:minHeight">@dimen/row_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Fairberry.TableCell</item>
    </style>
    <style name="Widget.Fairberry.TableCell.Remove" parent="Widget.Fairberry.TableCell">
        <item name="android:textColor">@color/state_danger</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="Widget.Fairberry.TableCell.Add" parent="Widget.Fairberry.TableCell.Remove">
        <item name="android:textColor">@color/accent</item>
        <item name="android:gravity">start|center_vertical</item>
    </style>
    <style name="Widget.Fairberry.TableHeader" parent="">
        <item name="android:textAppearance">@style/TextAppearance.Fairberry.TableHeader</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Widget.Fairberry.StatusLine" parent="">
        <item name="android:textAppearance">@style/TextAppearance.Fairberry.Status</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="Widget.Fairberry.Field" parent="">
        <item name="android:background">@drawable/field_bg</item>
        <!-- TextView defaults to FOCUSABLE_AUTO, which is focusable only outside touch mode, so
             tap-to-focus needs this explicitly. -->
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:textCursorDrawable">@drawable/field_cursor</item>
        <item name="android:textAppearance">@style/TextAppearance.Fairberry.Body</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:minHeight">@dimen/row_height</item>
        <item name="android:padding">@dimen/space_md</item>
    </style>

    <style name="Widget.Fairberry.Progress" parent="Widget.Material3.LinearProgressIndicator">
        <item name="indicatorColor">@color/accent</item>
        <item name="trackColor">@color/outline</item>
        <item name="trackThickness">6dp</item>
    </style>

    <style name="Widget.Fairberry.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/outline</item>
        <item name="android:layout_marginTop">@dimen/space_md</item>
    </style>

    <!-- The activity log header is also its control, so the caret and the words together
         form the target; the caret shows where the content will go when tapped. -->
    <style name="Widget.Fairberry.Expander" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAppearance">@style/TextAppearance.Fairberry.SectionTitle</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:minHeight">@dimen/header_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/space_sm</item>
        <item name="iconTint">@color/accent</item>
        <item name="iconSize">@dimen/expander_icon</item>
    </style>

    <style name="Widget.Fairberry.LogPreview" parent="">
        <item name="android:textAppearance">@style/TextAppearance.Fairberry.Caption</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
