<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.usb.host" />

    <application
        android:theme="@style/AppTheme.NoActionBar"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true">

        <!-- The keyboard is a HID device, so it disappearing while it re-enumerates as the
             CDC-only Caterina instance is a keyboard config change; handling it here keeps the
             app alive through a flash.
        -->
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|density|locale|layoutDirection|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- No USB_DEVICE_ATTACHED intent filter or device_filter.xml: that
                 makes Android resolve the app as the handler for the keyboard and
                 ask which app to open it with. The app takes the device through
                 its registered receiver instead. -->
        </activity>

    </application>

</manifest>
